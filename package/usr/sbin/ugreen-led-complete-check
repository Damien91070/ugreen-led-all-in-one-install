#!/bin/bash
set -euo pipefail
echo '=== DKMS ==='; dkms status -m led-ugreen -v 0.3 || true
echo '=== Services ==='; systemctl --no-pager --full status ugreen-probe-leds.service ugreen-diskiomon.service ugreen-netdevmon@enp89s0.service ugreen-led-manager-hotplug.service ugreen-led-manager-power.service || true
echo '=== LED mode ==='; /usr/sbin/ugreen-led-control status
