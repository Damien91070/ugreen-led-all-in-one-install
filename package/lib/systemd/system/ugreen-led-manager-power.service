[Unit]
Description=UGREEN Power LED (day 50 / night 10)
After=ugreen-probe-leds.service
Requires=ugreen-probe-leds.service
ConditionPathExists=/sys/class/leds

[Service]
ExecCondition=/usr/libexec/ugreen-led-power-enabled
Type=oneshot
ExecStartPre=/bin/sh -c 'i=0; until test -w /sys/class/leds/power/brightness; do i=$((i+1)); test "$i" -le 30 || exit 1; sleep 1; done'
ExecStart=/usr/libexec/ugreen-led-set-power
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
