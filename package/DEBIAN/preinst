#!/bin/sh
set -e
if [ "$1" = install ] || [ "$1" = upgrade ]; then
 b="/var/backups/ugreen-led-complete/preinstall-$(date +%Y%m%d-%H%M%S)"
 mkdir -p "$b"
 for f in /etc/ugreen-leds.conf /usr/local/sbin/ugreen-led-control /usr/local/sbin/ugreen-led-hotplug-monitor /etc/systemd/system/ugreen-power-led.service /etc/systemd/system/ugreen-led-hotplug.service /etc/systemd/system/ugreen-diskiomon.service.d/override.conf; do
  if [ -f "$f" ]; then mkdir -p "$b$(dirname "$f")"; cp -p "$f" "$b$f"; fi
 done
fi
